# This URL must identify a PostgreSQL role granted SELECT only on the CALMOS tables.
DATA_EXPLORER_DATABASE_READONLY_URL=postgresql+asyncpg://calmos_explorer@db:5432/dograh
# Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
DATA_EXPLORER_ADMIN_TOKEN=replace-with-a-long-random-token
# Set true only for a temporary localhost-only data-review session. Docker
# binds the service to 127.0.0.1; never enable this in a shared environment.
DATA_EXPLORER_LOCAL_TEST_MODE=false
DATA_EXPLORER_AUDIT_LOG_PATH=/var/log/calmos-data-explorer/audit.jsonl
DATA_EXPLORER_S3_BUCKET=private-calmos-artifacts
AWS_REGION=eu-west-2
# AWS_PROFILE=calmos-admin-sso
# For localhost MinIO only, source these ephemeral values from api/.env or
# Docker Compose; do not commit them here.
# MINIO_BUCKET=voice-audio
# MINIO_ACCESS_KEY=...
# MINIO_SECRET_KEY=...
# No AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY belongs in this file.
